      "right_table": "workspace.default.orderscsv"
    },
    {
      "config_path": "/Workspace/Repos/<user>/<repo>/pyspark_test/configs/products.yaml",
      "entity": "products",
      "environment": "dev",
      "suite": "products_databricks_self_compare",
      "left_type": "databricks",
